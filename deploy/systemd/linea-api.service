[Unit]
Description=Linea hosted API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=linea
Group=linea
WorkingDirectory=/opt/linea/current/services/api
EnvironmentFile=/etc/linea/backend.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/linea/venv/bin/python -m uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8000 --no-access-log
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/linea

[Install]
WantedBy=multi-user.target
