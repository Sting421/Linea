[Unit]
Description=Linea family web app
Wants=network-online.target
After=network-online.target linea-api.service

[Service]
Type=simple
User=linea
Group=linea
WorkingDirectory=/opt/linea/web/current/apps/web
EnvironmentFile=/etc/linea/web.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/linea/web/current/apps/web/.next/cache

[Install]
WantedBy=multi-user.target
