{
  "name": "reap",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_ENV=production remix vite:build",
    "dev": "cross-env NODE_OPTIONS='--stack-trace-limit=100000000' remix vite:dev",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "remix-serve build/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc",
    "icons": "npx @svgr/cli --out-dir public/icons -- public/icons",
    "icons:watch": "npm-watch icons",
    "dev:svg": "run-s icons icons:watch",
    "dev:remix": "remix dev",
    "all:dev": "run-p dev:*"
  },
  "watch": {
    "icons": {
      "patterns": [
        "icons"
      ],
      "extensions": "svg",
      "quiet": false
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.0.3",
    "@heroicons/react": "^2.1.3",
    "@react-google-maps/api": "^2.19.3",
    "@remix-run/node": "2.15.2",
    "@remix-run/react": "2.15.2",
    "@remix-run/serve": "2.15.2",
    "@tailwindcss/forms": "^0.5.7",
    "@tanstack/react-table": "^8.17.3",
    "@tanstack/react-virtual": "^3.10.8",
    "axios": "^1.7.5",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "date-fns": "^3.6.0",
    "dayjs": "^1.11.11",
    "isbot": "^4",
    "maplibre-gl": "^4.7.1",
    "react": "^18.2.0",
    "react-alice-carousel": "^2.9.1",
    "react-csv": "^2.2.2",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.5",
    "react-tailwindcss-datepicker": "^1.6.6",
    "react-tooltip": "^5.28.0",
    "reactflow": "^11.11.4",
    "recharts": "^2.12.7",
    "remix-utils": "^7.6.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.14.0",
    "@svgr/cli": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-prettier": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@tailwindcss/typography": "^0.5.13",
    "@types/react": "^18.2.20",
    "@types/react-csv": "^1.1.10",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.47.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "npm-run-all": "^4.1.5",
    "npm-watch": "^0.13.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-tsconfig-paths": "^5.1.2",
    "vitest": "^2.1.9"
  },
  "resolutions": {
    "@mapbox/jsonlint-lines-primitives": "2.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
