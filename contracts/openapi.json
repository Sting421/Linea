  "components": {
    "schemas": {
      "Contact": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "relationship": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Relationship"
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+[1-9]\\d{7,14}$",
            "title": "Phone"
          },
          "nearby": {
            "type": "boolean",
            "title": "Nearby",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "relationship",
          "phone"
        ],
        "title": "Contact"
      },
      "EventBody": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "leg_id": {
            "type": "string",
            "title": "Leg Id"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "kind",
          "leg_id"
        ],
        "title": "EventBody"
      },
      "Facts": {
        "properties": {
          "incident_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Incident Id"
          },
          "concern": {
            "type": "string",
            "enum": [
              "FALL",
              "BREATHING",
              "CHEST_PAIN",
              "DIZZINESS",
              "MEDICINE_NOT_TAKEN"
            ],
            "title": "Concern"
          },
          "subject": {
            "type": "string",
            "enum": [
              "elder",
              "other"
            ],
            "title": "Subject",
            "default": "elder"
          },
          "context": {
            "type": "string",
            "enum": [
              "actual",
              "near_event",
              "negated",
              "hypothetical",
              "remote_assessed"
            ],
            "title": "Context",
            "default": "actual"
          },
          "quote": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Quote"
          },
          "current": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current"
          },
          "resolved": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolved"
          },
          "mild": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mild"
          },
          "brief": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brief"
          },
          "familiar": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Familiar"
          },
          "usual_exertion": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usual Exertion"
          },
          "ongoing_pain": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ongoing Pain"
          },
          "injury": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Injury"
          },
          "functional_difficulty": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Functional Difficulty"
          },
          "repeated": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repeated"
          },
          "worsening": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Worsening"
          },
          "new_unusual": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "New Unusual"
          },
          "fainted": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fainted"
          },
          "emergency_features_absent": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Emergency Features Absent"
          },
          "red_flags": {
            "items": {
              "type": "string",
              "enum": [
                "cannot_get_up",
                "head_neck_back_hip_injury",
                "serious_injury",
                "severe_disabling_pain",
                "cannot_breathe",
                "gasping_choking",
                "cannot_speak_breathing",
                "blue_grey",
                "sudden_confusion",
                "chest_pressure",
                "spreading_pain",
                "sweating",
                "nausea_with_chest",
                "collapse",
                "one_sided_weakness",
                "speech_difficulty",
                "face_droop",
                "vision_loss",
                "severe_unusual_headache",
                "sudden_cannot_walk",
                "faint_incomplete_recovery",
                "faint_exertion",
                "faint_lying_down",
                "faint_serious_injury",
                "faint_palpitations",
                "overdose_poisoning"
              ]
            },
            "type": "array",
            "title": "Red Flags"
          },
