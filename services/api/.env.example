LINEA_MODE=connected
# Use connected for real Supabase Auth and records, with calls disabled.
# Apply all supabase/migrations in filename order. Fully live voice remains gated.
LINEA_VOICE_ENABLED=0
LINEA_VOICE_TEST_MODE=0
# For explicitly authorized acceptance calls only; scopes all voice to this one profile/account.
LINEA_TEST_ELDER_ID=
LINEA_TEST_OWNER_ID=
LINEA_PUSH_ENABLED=0
LINEA_PUBLIC_API_URL=https://lineaapi.aldrinvitorillo.dev
# Export verified ASR/TTS properties to an ignored private JSON file.
LINEA_AGORA_PROPERTIES_FILE=
# Private acceptance evidence: tester, tested_at, build and MVP-01..MVP-22 cases.
LINEA_LIVE_ACCEPTANCE_FILE=
LINEA_BUILD_ID=
LINEA_RUNTIME_JOURNAL_PATH=.local/runtime-journal
LINEA_DEMO_SEED=1
LINEA_DEMO_API_TOKEN=local-demo-only-change-me
LINEA_DATABASE_PATH=.local/linea.db
LINEA_APP_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# Optional reference only; runtime uses the full properties JSON above.
AGORA_PIPELINE_ID=
AGORA_FROM_NUMBER=
LINEA_CUSTOM_LLM_BEARER=
LINEA_PROVIDER_WEBHOOK_SECRET=
# In-process fact interpreter: one model call per new elder turn.
# Curated retrieval adds one embedding request per turn. Its synthetic index is
# bundled in services/api/data; no elder queries or embeddings are stored there.
OPENAI_API_KEY=
LINEA_SEMANTIC_MODEL=gpt-4.1-mini-2025-04-14
# Optional alternative: externally hosted semantic service, instead of the above.
LINEA_SEMANTIC_CLASSIFIER_URL=
LINEA_SEMANTIC_CLASSIFIER_TOKEN=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
